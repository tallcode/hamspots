{
  "name": "@dxsummit/server",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs",
    "dev": "pnpm run build && pm2 start --no-daemon ecosystem.config.cjs",
    "build": "tsc && cp -r src/data dist/",
    "stop": "pm2 stop ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "logs": "pm2 logs",
    "monit": "pm2 monit",
    "status": "pm2 status",
    "clean:pm2": "pm2 delete all && pm2 flush"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "hono": "^4.11.7",
    "mongodb": "^7.1.0",
    "nats": "^2.29.3",
    "openai": "^6.18.0",
    "pm2": "^6.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
